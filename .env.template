############################################
# DAO environment variable template
#
# Usage:
# 1) Copy to .env
# 2) Edit paths if needed
############################################

# Project root (optional; will be auto-inferred if empty)
PROJECT_ROOT=

# Hydra output directory (default: ${PROJECT_ROOT}/outputs/hydra)
HYDRA_JOBS=

# W&B output directory (default: ${PROJECT_ROOT}/outputs/wandb)
WANDB_DIR=

# Optional: if you want online W&B logging, set this in your private env.
# Do NOT commit API keys into the repository.
WANDB_API_KEY=
